rules_version = '2';

// Cada persona solo ve y escribe lo suyo, bajo users/{uid}/.
// La bitácora (movimientos) solo crece: se puede crear, nunca editar ni borrar.
service cloud.firestore {
  match /databases/{database}/documents {
    function esDuena(uid) {
      return request.auth != null && request.auth.uid == uid && invitada();
    }

    // Beta cerrada: solo entran los correos invitados. El repositorio es público, así que se guarda el
    // SHA-256 del correo en minúsculas, no el correo. Para invitar a alguien:
    //   node -e "console.log(require('crypto').createHash('sha256').update('correo@ejemplo.com').digest('hex'))"
    // pega el resultado en la lista y publica: npx firebase deploy --only firestore:rules
    function invitada() {
      return request.auth.token.email_verified == true
        && hashing.sha256(request.auth.token.email.lower()).toHexString().lower() in [
          // INVITADAS
          '1050ef4513f997527d88e7ab64449d76d90a70f0f4d729e2007511cbf3f16633', // dueña
          '4ccc9470333b08c0f05e77f2846e6a88bf82c95b76ecc7678a88e62f5ced5ad5', // tester 1
          'f36da3395857713df7fc7b7cdb67e82710c478d8d4d559aae51559a068d08e8c', // tester 2
        ];
    }

    function movimientoValido(id) {
      let m = request.resource.data;
      return m.keys().hasAll(['id', 'ts', 'tipo', 'monto', 'moneda', 'quien', 'afectaMisCifras', 'nota', 'claveUnica'])
        && m.keys().hasOnly(['id', 'ts', 'tipo', 'monto', 'moneda', 'cuentaId', 'deudaId', 'compromisoId',
                             'quien', 'afectaMisCifras', 'nota', 'reversaDe', 'claveUnica'])
        && m.claveUnica == id
        && m.ts is int
        && m.monto is int
        && m.tipo in ['ingreso', 'gasto', 'pago_deuda', 'reverso', 'ajuste']
        && m.moneda in ['MXN', 'USD']
        && m.quien in ['yo', 'pareja', 'otro']
        && m.afectaMisCifras is bool
        && m.nota is string && m.nota.size() <= 500;
    }

    match /users/{uid} {
      match /movimientos/{id} {
        allow read: if esDuena(uid);
        allow create: if esDuena(uid) && movimientoValido(id);
        allow update, delete: if false;
      }

      // Cuentas, deudas, compromisos, ingresos y config sí se editan (cambian con cada estado de cuenta).
      // La lista deja fuera a movimientos: las reglas se suman y este match también lo alcanzaría.
      match /{coleccion}/{id} {
        allow read, write: if esDuena(uid) && coleccion in ['config', 'cuentas', 'deudas', 'compromisos', 'ingresos'];
      }
    }
  }
}
