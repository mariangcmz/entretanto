{
  "name": "entretanto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emuladores": "vite --mode emuladores",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:reglas": "firebase emulators:exec --only firestore --project demo-entretanto \"vitest run tests/reglas.test.ts\"",
    "emuladores": "firebase emulators:start --only auth,firestore --project demo-entretanto"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@preact/preset-vite": "^2.10.6",
    "@vite-pwa/assets-generator": "^2.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
